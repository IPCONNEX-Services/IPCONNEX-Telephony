# Copy to .env and fill in values. Loaded via `source .env` before bench commands.
# Values come from the IPCONNEX Infisical project (see skills/ipconnex-infisical/SKILL.md).

# Infisical (self-hosted) — used by ipconnex_telephony.utils.infisical
INFISICAL_URL=http://10.100.10.230
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# Which project/environment the Telephony Settings singleton should read from.
# These are also defaulted on the Telephony Settings DocType itself (infisical_project_slug, infisical_environment).
INFISICAL_PROJECT_SLUG=tenant-ipconnex
INFISICAL_ENVIRONMENT=prod
